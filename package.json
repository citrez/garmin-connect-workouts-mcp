{
  "name": "@citrez/garmin-connect-workouts-mcp",
  "mcpName": "io.github.citrez/garmin-connect-workouts-mcp",
  "version": "1.4.0",
  "description": "MCP server that turns natural-language workout descriptions into structured Garmin Connect workouts, with pace/heart-rate/power/cadence targets and real repeat blocks.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "garmin-connect-workouts-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "plugin.json",
    "mcp.json",
    ".codex-plugin/plugin.json",
    "skills/**/*",
    "assets/**/*",
    "docs/**/*",
    "CHANGELOG.md",
    "server.json",
    "manifest.json",
    "installers/**/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/mcp-server.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "release:artifacts": "npm run build && node scripts/release-artifacts.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "keywords": [
    "garmin",
    "workout",
    "mcp",
    "claude",
    "fitness",
    "training",
    "garmin-connect"
  ],
  "author": "Christoph Salat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citrez/garmin-connect-workouts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/citrez/garmin-connect-workouts-mcp/issues"
  },
  "homepage": "https://github.com/citrez/garmin-connect-workouts-mcp#readme",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@puppeteer/browsers": "3.2.1",
    "@types/node": "^26.4.1",
    "esbuild": "0.28.0",
    "fflate": "0.8.2",
    "puppeteer-core": "25.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
